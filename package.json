{
  "name": "vantage",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "onlyBuiltDependencies": [
    "@nestjs/core",
    "@prisma/client",
    "@prisma/engines",
    "@scarf/scarf",
    "bcrypt",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
